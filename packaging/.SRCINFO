pkgbase = cirax
	pkgdesc = Universal local conversion hub — every format to every format, fully offline
	pkgver = 0.3.0
	pkgrel = 1
	url = https://github.com/baselanaya/Cirax
	arch = any
	license = MIT
	makedepends = python-build
	makedepends = python-installer
	makedepends = python-hatchling
	depends = python>=3.10
	depends = python-yaml
	depends = python-rich
	optdepends = ffmpeg: audio/video engine (recommended)
	optdepends = libvips: fast image engine (recommended)
	optdepends = imagemagick: wide image format net
	optdepends = 7zip: archive engine (recommended)
	optdepends = ghostscript: PDF compression/raster
	optdepends = qpdf: lossless PDF surgery
	optdepends = poppler: PDF text/raster extract
	optdepends = libreoffice-still: office documents
	optdepends = pandoc: markup conversion
	optdepends = calibre: ebooks
	optdepends = inkscape: vector hub
	optdepends = librsvg: SVG rasterizer
	optdepends = darktable: camera RAW
	optdepends = libheif: HEIC decode
	optdepends = libjxl: JPEG XL
	optdepends = libavif: AVIF
	optdepends = libwebp: WebP
	optdepends = perl-image-exiftool: metadata ops
	optdepends = pngquant: PNG palette compression
	optdepends = oxipng: lossless PNG optimizer
	optdepends = gifsicle: GIF optimizer
	optdepends = mkvtoolnix-cli: Matroska surgery
	optdepends = sox: audio DSP
	optdepends = opus-tools: Opus encoding
	optdepends = zstd: single-file compression
	optdepends = jq: JSON
	optdepends = go-yq: JSON/YAML/XML/CSV converter
	optdepends = miller: record formats
	optdepends = duckdb: CSV/Parquet/JSON
	optdepends = tesseract-data-eng: OCR fallback data (also install tesseract)
	optdepends = ocrmypdf: searchable PDFs
	optdepends = img2pdf: lossless image->PDF
	optdepends = mupdf-tools: PDF clean
	optdepends = unar: archive extraction
	optdepends = libisoburn: ISO authoring
	optdepends = qemu-img: VM disk images
	optdepends = assimp: 3D models
	optdepends = python-fonttools: fonts
	optdepends = gdal: geospatial
	optdepends = dos2unix: line endings
	optdepends = ollama: local AI models (GLM-OCR, whisper)
	options = !strip
	source = cirax-0.3.0.tar.gz::https://github.com/baselanaya/Cirax/archive/refs/tags/v0.3.0.tar.gz
	sha256sums = SKIP

pkgname = cirax
